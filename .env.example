# O Compose funciona sem .env no modo demonstrativo abaixo.
# Copie este arquivo somente se ainda não tiver um .env; preserve sua chave existente.
APP_ENV=development
# Chaves de provedores de IA devem ser informadas pelo usuário na interface, nunca aqui.
# Chave mestra Fernet para cifrar credenciais de provedores salvas pela interface.
# Gere uma chave com cryptography. Mantenha-a estável; perdê-la impede descriptografar credenciais.
SETTINGS_ENCRYPTION_KEY=
PROMPT_VERSION=retail-v3
CACHE_TTL_SECONDS=86400
GENERATION_TIMEOUT_SECONDS=90
POSTGRES_USER=copy
POSTGRES_PASSWORD=copy_local
POSTGRES_DB=copy
REDIS_PASSWORD=redis_local
# Usados fora do Compose; dentro da rede os hosts são postgres e redis.
DATABASE_URL=postgresql+asyncpg://copy:copy_local@localhost:5432/copy
REDIS_URL=redis://:redis_local@localhost:6379/0
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://127.0.0.1:8080","http://192.168.3.83:8080"]
