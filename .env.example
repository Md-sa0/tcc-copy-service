# O Compose funciona sem .env no modo demonstrativo abaixo.
# Copie este arquivo somente se ainda não tiver um .env; preserve sua chave existente.
APP_ENV=development
LLM_PROVIDER=mock
# Para inferência real: LLM_PROVIDER=gemini e uma chave válida abaixo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROMPT_VERSION=retail-v1
CACHE_TTL_SECONDS=86400
GENERATION_TIMEOUT_SECONDS=90
RETRY_ATTEMPTS=3
RETRY_BASE_SECONDS=1
# Em produção: chave aleatória >=32 caracteres; digite-a no campo de acesso da SPA.
# Nunca coloque chaves em variáveis VITE_* ou no código frontend.
API_KEY=
POSTGRES_USER=copy
POSTGRES_PASSWORD=copy_local
POSTGRES_DB=copy
REDIS_PASSWORD=redis_local
# Usados fora do Compose; dentro da rede os hosts são postgres e redis.
DATABASE_URL=postgresql+asyncpg://copy:copy_local@localhost:5432/copy
REDIS_URL=redis://:redis_local@localhost:6379/0
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
